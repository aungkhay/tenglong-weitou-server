{
  "appenders": [{
    "type": "file",
    "filename": "./logs/node-log-${opts:serverId}.log",
    "fileSize": 1048576,
    "layout": {
      "type": "basic"
    },
    "backups": 2
  }, {
    "type": "console"
  }, {
    "type": "file",
    "filename": "./logs/con-log-${opts:serverId}.log",
    "pattern": "connector",
    "fileSize": 1048576,
    "layout": {
      "type": "basic"
    },
    "backups": 2,
    "category": "con-log"
  }, {
    "type": "file",
    "filename": "./logs/rpc-log-${opts:serverId}.log",
    "fileSize": 1048576,
    "layout": {
      "type": "basic"
    },
    "backups": 2,
    "category": "rpc-log"
  }, {
    "type": "file",
    "filename": "./logs/forward-log-${opts:serverId}.log",
    "fileSize": 1048576,
    "layout": {
      "type": "basic"
    },
    "backups": 2,
    "category": "forward-log"
  },{
    "type": "file",
    "filename": "./logs/my-log.log",
    "fileSize": 1048576,
    "layout": {
      "type": "basic"
    },
    "backups": 2,
    "category": "my-log"
  }, {
    "type": "file",
    "filename": "./logs/crash.log",
    "fileSize": 1048576,
    "layout": {
      "type": "basic"
    },
    "backups": 2,
    "pattern": "-MM-dd-hh",
    "category": "crash-log"
  }],
  "levels": {
      "process":"ERROR",
      "con-log" : "ERROR",
      "admin-log" : "ERROR",
      "pomelo" : "ERROR",
      "rpc-log" : "ERROR",
      "forward-log": "ERROR"
   },
  "replaceConsole": true,
  "lineDebug": false
}