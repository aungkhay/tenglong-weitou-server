router.post('/get_spm_info', async function(req, res) {
    //try {
        let msg = req.body.data ? req.body.data : req.body;
        await redlock.lock("get_spm_info:" + msg.userId,1000);

        if(!msg.group_nickname || msg.group_nickname == ""){
            return res.send({code:500,msg:"没有提供开工群昵称",data:null});
        }
        let parameter_setup = await systemDao.getParameter(msg);
        if(parameter_setup.data && parameter_setup.data.length > 0){
            parameter_setup = parameter_setup.data[0];
        }

        let groupInfo = await systemDao.getGroupPullDataSetup(msg);
        if(groupInfo.data && groupInfo.data.length > 0){
            groupInfo = groupInfo.data[0];
            msg.statistics_date = moment(groupInfo.statistics_date).format('YYYY-MM-DD');

            let stateRedisKey = groupInfo.rType + "st:" + groupInfo.Id;
            let re = await cache.get(stateRedisKey);
            if(!!re){
                msg.cc = re.cc ? re.cc : msg.shoe;
                msg.jc = re.jc ? re.jc : msg.round;
            }
            msg.is_re_settlement = false;
        }

        // 调用 DAO 并取出 data 数组
        console.log("获取上盘买信息，参数：", msg);
        let daoRes = await userDao.getJcTotal(msg);
        let rows = (daoRes && daoRes.data) ? daoRes.data : [];
        if (rows.length === 0) {
            return res.send({code:500,msg:"没有找到结算数据",data:null});
        }

        // 取第一条数据为 r
        let r = rows[0];

        // 与停止下注减持共用同一套最终 spm/sp 算法。
        const spmInfo = calculateSpmInfo(r, parameter_setup);
        r.spm = spmInfo.spm;
        r.sp = spmInfo.sp;
        r.lt = spmInfo.smallChange;

        let data = {
            spm: r.spm,
            value: r.sp
        };

        return res.send({code:200,msg:"获取记录成功",data:data});
    // } catch (err) {
    //     console.log("err:",JSON.stringify(err));
    //     return res.send({code:500,msg:"服务器繁忙",data:null});
    // }
});
