router.post('/get_player_bet_data', async function(req, res) {    
    let msg = req.body.data ? req.body.data : req.body;
    let lock =  await redlock.lock("get_player_bet_data:" + msg.userId,1000);
    //try{                                           

        if(!msg.group_nickname || msg.group_nickname == ""){
            return res.send({code:500,msg:"没有提供开工群昵称",data:null}); 
        }

        let rInfo = await systemDao.getGroupPullDataSetup(msg);
        if(!rInfo.data[0].statistics_date)rInfo.data[0].statistics_date = new Date();
        msg.statistics_date = moment(rInfo.data[0].statistics_date).format('YYYY-MM-DD');
        let stateRedisKey = rInfo.data[0].rType + "st:" + rInfo.data[0].Id;
        let re = await cache.get(stateRedisKey);
        if(!!re){
            msg.shoe = re.cc ? re.cc : msg.shoe;
            msg.round = re.jc ? re.jc : msg.round;
        }

        console.log("==============================获取投注表数据，场次局次：", msg.shoe, msg.round);

        let row = await playerDao.getPlayerBetData(msg);   
        row = row.data;
        row = row.map (item =>{
            let s = {};
            s.name = item.userName;
            s.bet_detail = {
                bank:item.z,
                tie:item.h,
                player:item.x,
                bankPair:item.zd,
                playerPair:item.xd,
                //lucky6:item.l,
                l:item.l,
                k:item.k,
                lucky7:item.q,
                perfect:item.m,
                pair:item.d
            }
            return s;
        })
        if(row){
            lock.unlock();
            return res.send({code:200,msg:"获取记录成功",data:row});  
        }else{
            lock.unlock();
            return res.send({code:500,msg:"获取记录失败",data:null});  
        }
    // } catch (err) {
    //     lock.unlock();
    //     console.log("err:",JSON.stringify(err));
    //     return res.send({code:500,msg:"服务器繁忙",data:null});
    // }
})

router.post('/get_player_score_data', async function(req, res) {
    let msg = req.body.data ? req.body.data : req.body;
    let lock =  await redlock.lock("get_player_score_data:" + msg.userId,1000);
    try{                      
        if(!msg.group_nickname || msg.group_nickname == ""){
            return res.send({code:500,msg:"没有提供开工群昵称",data:null}); 
        }

        let rInfo = await systemDao.getGroupPullDataSetup(msg);

        let stateRedisKey = rInfo.data[0].rType + "st:" + rInfo.data[0].Id;
        let re = await cache.get(stateRedisKey);
        if(!!re){
            msg.shoe = re.lastResultCc ? re.lastResultCc : msg.shoe;
            msg.round = re.lastResultJc ? re.lastResultJc : msg.round;
        }
        if(!rInfo.data[0].statistics_date)rInfo.data[0].statistics_date = new Date();
        msg.statistics_date = moment(rInfo.data[0].statistics_date).format('YYYY-MM-DD');

        console.log(`==============获取分表数据，场次局次：${msg.shoe}, ${msg.round}, ${re.lastResultCc}, ${re.lastResultJc}`);
        let row = await playerDao.getPlayerScoreData(msg);   
        row = row.data;

        if(row){
            row.forEach(element => {
                element.shoe = msg.shoe;
                element.round = msg.round;
            });
            lock.unlock();
            return res.send({code:200,msg:"获取记录成功",data:row});  
        }else{
            lock.unlock();
            return res.send({code:500,msg:"获取记录失败",data:null});  
        }

    } catch (err) {
        lock.unlock();
        console.log("err:",JSON.stringify(err));
        return res.send({code:500,msg:"服务器繁忙",data:null});
    }
})

// 获取桌子信息
router.post('/get_desk_info', async function(req, res) {  
    try{                      
        let msg = req.body.data ? req.body.data : req.body;
        await redlock.lock("get_desk_info:" + msg.userId,1000);
        //let game = HG_TRANS.gameIdTransOwn(msg.desk_number);
        if(!msg.group_nickname || msg.group_nickname == ""){
            return res.send({code:500,msg:"没有提供开工群昵称",data:null}); 
        }
        let game = await systemDao.getGroupPullDataSetup(msg);
        if(game.data.length == 0){
            return res.send({code:500,msg:"没有找到开工群昵称,请先设定",data:null}); 
        }

        msg.rType = "bjl";
        msg.roomId = game.data[0].Id;
        let rpc = pomelo.app.rpc; 
        let gt = game.rType;
        msg.gameId = game.data[0].Id;
        let o = rpc.bjl.bjlRemote;
        o.getRoomInfo(null,msg,function(result){
            console.log("info：",result);
            if(result.code != '500'){
                let r = result.data;
                r.gameStatus = Number(r.gameStatus)
                let obj = {
                    shoe: r.cc,
                    round: r.jc,
                    gameStatus: r.gameStatus,
                    desk_number: r.gameId,
                    betTime: r.betTime,
                    gameHistory: r.gameHistory
                }
                return res.send({code:200,msg:"获取记录成功",data:obj});  
            }else{
                return res.send({code:500,msg:"获取记录失败",data:null});  
            }
        });
      
    } catch (err) {
        console.log("err:",JSON.stringify(err));
        return res.send({code:500,msg:"服务器繁忙",data:null});
    }
})

