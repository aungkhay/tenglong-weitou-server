// 查询单个选手下注流水
router.post('/bet_details_query_by_name', async function(req, res) { 
    try{                                              
        let msg = req.body.data ? req.body.data : req.body;
        await redlock.lock("bet_details_query_by_name:" + msg.userId,2000);
        
        if(!msg.group_nickname || msg.group_nickname == ""){
            return res.send({code:500,msg:"没有提供开工群昵称",data:null}); 
        }

        //if(msg.endTime)msg.endTime += " 23:59:59";

        let row = await playerDao.betDetailsQueryByName(msg);   
        row = row.data;
        row = row.map (item =>{
            let s = {};
            s.nickname = item.userName;
            s.shoe = item.cc + "-" + item.jc;
            s.betMoney = item.xz,
            s.bet_order = item.bet_order;
            s.bet_format = item.bet_order;
            s.bet_time = item.betTime ? util.transDate(item.betTime) : "";
            s.result = item.kj;
            s.profit = item.yl,
            s.result_time = item.stime ? util.transDate(item.stime) : "";
            s.result_status = item.kj && item.kj != "" ? "己结算": "未结算";
            s.result_rawstring = item.xzmx;
            s.before_bet_money = item.before_bet_ye;
            s.raw_money = item.initial_amount;
            return s;
        })

        if(row){
            return res.send({code:200,msg:"获取记录成功",data:row});  
        }else{
            return res.send({code:500,msg:"获取记录失败",data:null});  
        }
    } catch (err) {
        console.log("err:",JSON.stringify(err));
        return res.send({code:500,msg:"服务器繁忙",data:null})
    }
})

