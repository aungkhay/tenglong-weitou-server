let express = require("express");
let router = express.Router();
let playerDao = require('../../dao/playerDao');
let userDao = require('../../dao/userDao');
let systemDao = require('../../dao/systemDao');
let playerOptionDao =  require('../../dao/playerOptionDao');
let pomelo = require("pomelo");
let redlock = pomelo.app.get('redlock');
const util = require('../../util/utils');
let cache = require('../../dao/Cache');
const moment = require('moment');
const { calculateSpmInfo } = require('../../domain/sx/overSpm');


// 按天按靴查询单个选手明细(查询单个选手当天所有靴的明细汇总)
router.post('/player_details_query_by_shoe', async function(req, res) {  
    try{                                             
        let msg = req.body.data ? req.body.data : req.body;
        await redlock.lock("player_details_query_by_shoe:" + msg.userId,2000);
        
        if(!msg.name){
            return res.send({code:500,msg:"没有设置账号",data:null}); 
        }

        if(!msg.group_nickname || msg.group_nickname == ""){
            return res.send({code:500,msg:"没有提供开工群昵称",data:null}); 
        }

        //if(msg.endTime)msg.endTime += " 23:59:59";

        let row = await playerDao.playerDetailsQueryByShoe(msg);   
        row = row.data;
        if(row.length > 0){
            msg.is_virtual = 0;  // is_contains_virtual 是否包含虚拟
            if(typeof msg.is_contains_virtual === 'number' && msg.is_contains_virtual == 0){
                let row2 = await playerDao.getPlayer(msg);   
                row2 = row2.data; 
                if(row2.length > 0){
                    const playerNameSet = new Set(row2.map(item => item.playername));
                    // 只保留row中username存在于playerNameSet中的记录
                    row = row.filter(item => {
                        const exists = playerNameSet.has(item.username);
                        return exists;
                    });
                }
            }
        }
        if(row){
            return res.send({code:200,msg:"获取记录成功",data:row});  
        }else{
            return res.send({code:500,msg:"获取记录失败",data:null});  
        }
    } catch (err) {
        console.log("err:",JSON.stringify(err));
        return res.send({code:500,msg:"服务器繁忙",data:null})
    }
})

